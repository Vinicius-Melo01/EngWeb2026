extends layout_stats

block content
    .w3-card-4
        header.w3-container.w3-teal
            h2 Estatísticas das Publicações do JCR
            
        div.w3-container.w3-padding-16
            div.w3-row-padding
                // Gráfico por Ano
                div.w3-half.w3-margin-bottom(style="max-width: 50%;")
                    canvas#chartAno
                // Gráfico por Tipo
                div.w3-half.w3-margin-bottom(style="max-width: 50%;")
                    canvas#chartTipo
                // Gráfico por Autor
                div.w3-half.w3-margin-bottom(style="max-width: 50%;")
                    canvas#chartAutor

    