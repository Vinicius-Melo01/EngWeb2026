extends layout
block content
  .w3-card-4
    header.w3-container.w3-teal
      h1= tipo === 'ator' ? `Ator: ${dados.nome}` : `Detalhes do Filme "${dados.title}"`
    
    .w3-container.w3-padding
      if tipo === 'ator'
        p
          strong Nome:
          | #{dados.nome}
        p
          strong Filmes em que participou:
        ul
          each f in dados.filmes
            li
              a(href=`/filmes/${f.id}`)= f.title
      
      else
        p
          strong ID:
          | #{dados.id}
        p
          strong Titulo:
          | #{dados.title}
        p
          strong Ano:
          | #{dados.year}
        p
          strong Géneros:
          | #{dados.genres.join(", ")}
        p
          strong Elenco:
          | #{dados.cast.join(", ")}
      
      a.w3-btn.w3-grey.w3-margin-left(href=tipo === 'ator' ? '/atores' : '/') Voltar à Lista