extends layout

block content
  .w3-card-4
    header.w3-container.w3-teal
      h1 Lista de Filmes 
    
    .w3-container
  table.w3-table-all.w3-margin-top
    tr
      th ID
      th Titulo
      th Ano
      th Gêneros
      th 
        a(href='/atores') Elenco
    each f in list
      tr
        td= f.id
        td
          a(href=`/filmes/${f.id}`)= f.title
        td= f.year
        td= f.genres.join(", ")
        td= f.cast.join(", ")
                

