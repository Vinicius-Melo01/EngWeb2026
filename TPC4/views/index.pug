extends layout

block content
  .w3-card-4
    header.w3-container.w3-teal
      h1 EMD Records List 
        a.w3-btn.w3-round.w3-grey(href="/emd/registo") + 
    
    .w3-container
  table.w3-table-all.w3-margin-top
    tr
      th Data EMD
      th Nome
      th Idade
      th Modalidade
      th Resultado
      th Operações
    each t in list
      tr
        td= t.dataEMD
        td
          a(href=`/emd/${t.id}`)= t.nomePrimeiro + " " + t.nomeUltimo
        td= t.idade
        td= t.modalidade
        td= t.resultado
        td
          a.w3-btn.w3-round.w3-blue-grey.w3-small(href=`/emd/editar/${t.id}`) Editar
          a.w3-btn.w3-round.w3-red.w3-small.w3-margin-left(href=`/emd/apagar/${t.id}`) Apagar
                

