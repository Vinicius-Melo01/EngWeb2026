extends layout.pug

block content
  .w3-container
    h2 Marca: #{marca}
    
    h3 Modelos intervencionados
    ul
      each m in modelos
        li= m
    
    h3 Reparações
    table.w3-table-all
      tr.w3-teal
        th Id
        th Data
        th Nome
        th Matrícula
        th Nº Intervenções
      each r in repairs
        tr
          td
            a(href="/repair/" + r.id)= r.id
          td= r.data
          td= r.nome
          td= r.viatura.matricula
          td= r.nr_intervencoes
    
    a(href="/") Voltar