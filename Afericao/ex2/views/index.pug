extends layout.pug

block content
  .w3-container
    h2 Lista de Reparações (#{repairs.length})
    table.w3-table-all
      tr.w3-teal
        th Id
        th Data
        th Nome
        th Matrícula
        th Marca
        th Nº Intervenções
      each r in repairs
        tr
          td
            a(href="/" + r.id)= r.id
          td= r.data
          td= r.nome
          td= r.viatura.matricula
          td
            a(href="/" + r.viatura.marca)= r.viatura.marca
          td= r.nr_intervencoes